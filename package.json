{
  "name": "changesets-snapshot-release",
  "version": "1.1.2",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --transpile-only --minify",
    "check-types": "tsc --noEmit",
    "format": "prettier --check \"./**/*.{ts,mjs,json,md,yml}\"",
    "lint": "eslint . --ext .ts,.mjs",
    "release": "yarn build && node scripts/release.mjs",
    "version-package": "changeset version"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@changesets/read": "^0.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "sort-package-json": "^3.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "packageManager": "yarn@4.13.0"
}
